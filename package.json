{
  "name": "@nymrel/portal",
  "version": "1.0.0",
  "description": "Static source catalog and interactive reference for the Nymrel open-source ecosystem.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nymrel <contact@nymrel.com>",
  "homepage": "https://nymrel.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nymrel/nymrel-ecosystem-portal.git"
  },
  "keywords": [
    "nymrel",
    "agent-ecosystem",
    "ai-agents",
    "open-source",
    "warm-paper",
    "agent-to-ui",
    "universal-commerce-protocol",
    "machine-trust",
    "proof-ledger",
    "jalenbuilds"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:artifact",
    "check:artifact": "node scripts/check-portal.mjs",
    "lint": "oxlint --type-aware src test scripts/check-portal.mjs vite.config.ts --deny-warnings --report-unused-disable-directives",
    "sync-llms": "node --experimental-strip-types scripts/generate-llms.mjs",
    "test": "node --test test/**/*.test.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.22.2 <27",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "sideEffects": [
    "**/*.css"
  ]
}
